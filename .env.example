SIGNAL_ENV=development
DATABASE_URL=postgres://aero:change-me@127.0.0.1:5432/aero_signal_dev
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=signal:
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=aero
S3_SECRET_KEY=change-me
S3_BUCKET=aero-signal-dev
BROWSER_CDP_URL=http://127.0.0.1:9222
# 公众号后台真实协议（mp_admin）；生产/阶段 B 设为 1
# SIGNAL_MP_ADMIN_PROTOCOL=1
# mp_admin 请求使用的 User-Agent；留空使用内置默认值（桌面 Chrome 123 UA）
# SIGNAL_MP_ADMIN_USER_AGENT=
# 当前只有 Fake OCR；production 会拒绝 Fake，待 R05 接入真实 provider。
SIGNAL_OCR_PROVIDER=fake
# 监听地址（默认 127.0.0.1:8080）
SIGNAL_LISTEN_ADDR=127.0.0.1:8080
# 仓储模式：memory | postgres。未设时：有 DATABASE_URL → postgres，否则 memory
# SIGNAL_STORE=postgres
# 仅 memory：HTTP 进程内嵌 Worker（联调方便；生产请用独立 signal-worker）
# SIGNAL_EMBED_WORKER=1
# Worker 日调度（07:30 preflight / 08:00 plan）；signal-worker 默认开启，设 0 关闭
# SIGNAL_SCHEDULER=1
# 密钥文件目录：postgres / production 模式必填（data/ 已被 .gitignore 忽略）
# SIGNAL_SECRET_STORE_PATH=./data/secrets
# Bootstrap：首次部署创建唯一管理员（勿提交真实密码）
# signal-service 启动时若两者均非空且库中尚无管理员，则自动 bootstrap（首次登录强制改密）；已有管理员时跳过。
SIGNAL_BOOTSTRAP_USERNAME=
SIGNAL_BOOTSTRAP_PASSWORD=
# HTTP bootstrap（POST /api/admin/auth/bootstrap）所需的初始化口令；请求体 bootstrap_token 必须与之一致。
# 留空则禁用 HTTP bootstrap；已有管理员时该接口一律拒绝。请使用足够长的随机值，初始化完成后可移除。
SIGNAL_BOOTSTRAP_TOKEN=
RUST_LOG=info,signal=debug
